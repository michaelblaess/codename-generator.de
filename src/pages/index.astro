---
import Base from '../layouts/Base.astro';
import Generator from '../components/Generator.tsx';
import { themes } from '../lib/generator';

const list = themes().filter((t) => !t.slug.startsWith('random'));
const wordCount = list.reduce((sum, t) => sum + t.words.length, 0);

// Der Scroller traegt, was sonst als Fliesstext Platz kosten wuerde.
const scroller = [
  'CODENAME GENERATOR',
  `${list.length} THEMEN`,
  `${wordCount} WOERTER`,
  'ENGLISCH UND DEUTSCH',
  'IM DEUTSCHEN WIRD DER ZUSATZ GEBEUGT: STILLER FALKE - STILLE EULE - STILLES WIESEL',
  'ALLES LAEUFT IM BROWSER, NICHTS WIRD GESENDET',
  'DIESELBEN WORTLISTEN TREIBEN DIE TERMINALFASSUNG AN: GITHUB.COM/MICHAELBLAESS/CODENAME-GENERATOR',
  'NAMEN KOENNEN MIT BESTEHENDEN PRODUKTNAMEN ZUSAMMENFALLEN - VOR VERWENDUNG PRUEFEN',
  'MICHAEL BLAESS 2026 - APACHE 2.0 - SCHRIFT PRESS START 2P (OFL)',
].join('   ***   ');
---

<Base
  title="Codename Generator - project codenames from curated themes"
  description={`Generate project codenames from ${list.length} curated themes and ${wordCount} words, in English or German, with optional phonetic mutation.`}
>
  <div class="bildschirm">
    <!-- Copper-Balken: der Vorspann faengt oben an. -->
    <div class="copper"></div>

    <!-- Kopf: knapp gehalten, damit alles in einen Bildschirm passt. -->
    <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 pt-3">
      <h1 class="pixel gold text-[0.95rem] sm:text-[1.25rem]">CODENAME GENERATOR</h1>
      <p class="pixel text-[0.5rem] text-magenta">
        {list.length} THEMEN · {wordCount} WOERTER · EN/DE<span class="blinker"></span>
      </p>
    </header>

    <Generator client:only="react" />

    <!-- Scroller: die Laufschrift gehoert zu einem Titelbildschirm dazu. -->
    <div class="scroller pixel text-[0.5rem]">
      <span>{scroller}</span>
    </div>
  </div>
</Base>
