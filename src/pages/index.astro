---
import Base from '../layouts/Base.astro';
import Generator from '../components/Generator.tsx';
import { themes } from '../lib/generator';

const list = themes().filter((t) => !t.slug.startsWith('random'));
const wordCount = list.reduce((sum, t) => sum + t.words.length, 0);
---

<Base
  title="Codename Generator - project codenames from curated themes"
  description={`Generate project codenames from ${list.length} curated themes and ${wordCount} words, in English or German, with optional phonetic mutation.`}
>
  <div class="mx-auto max-w-5xl px-3 py-6 sm:py-10">
    <div class="abriss"></div>

    <div class="bahn py-8">
      <!-- Kopf des Fernschreibers: Absender, Betreff, Laufzettel. -->
      <header class="mb-8">
        <p class="text-[0.66rem] tracking-telex text-durchschlag">
          MICHAEL BLAESS · WERKZEUG NR. 7
        </p>
        <h1 class="mt-2 text-3xl font-semibold leading-none tracking-tight sm:text-[2.7rem]">
          CODENAME GENERATOR
        </h1>
        <p class="mt-4 max-w-[46rem] text-[0.9rem] leading-relaxed text-druck">
          Ein Projekt braucht einen Namen, bevor es einen Ordner braucht. Diese Maschine
          druckt {list.length} Themen und {wordCount} Wörter zu Namenspaaren zusammen, auf
          Englisch oder Deutsch. Alles läuft in deinem Browser, nichts wird gesendet.
        </p>
      </header>

      <Generator client:only="react" />

      <!-- Fusszettel im Ton eines Laufzettels, keine Marketingprosa. -->
      <footer
        class="mt-12 border-t border-dashed border-[#cfc6b6] pt-5 text-[0.74rem] leading-relaxed text-durchschlag"
      >
        <div class="grid gap-6 sm:grid-cols-3">
          <p>
            <span class="block tracking-telex text-[0.62rem]">BAUART</span>
            Ein Name besteht aus einem Themenwort und einem Zusatz. Im Deutschen richtet
            sich der Zusatz nach dem Geschlecht des Substantivs: Stiller Falke, Stille Eule,
            Stilles Wiesel.
          </p>
          <p>
            <span class="block tracking-telex text-[0.62rem]">HERKUNFT</span>
            Dieselben Wortlisten treibt die Terminalfassung an:
            <a
              class="text-druck underline decoration-farbband underline-offset-2"
              href="https://github.com/michaelblaess/codename-generator">codename-generator</a
            >.
          </p>
          <p>
            <span class="block tracking-telex text-[0.62rem]">VORBEHALT</span>
            Namen entstehen aus Wortlisten und können mit bestehenden Produkt-, Projekt- oder
            Firmennamen zusammenfallen. Vor öffentlicher Verwendung prüfen.
          </p>
        </div>
        <p class="mt-6 text-[0.66rem] tracking-telex">
          <a class="hover:text-farbband" href="https://michaelblaess.de">MICHAELBLAESS.DE</a>
          <span class="mx-2">·</span>APACHE 2.0
        </p>
      </footer>
    </div>

    <div class="abriss"></div>
  </div>
</Base>
