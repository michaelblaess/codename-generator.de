---
import Base from '../layouts/Base.astro';
import Generator from '../components/Generator.tsx';
import { themes } from '../lib/generator';

const list = themes().filter((t) => !t.slug.startsWith('random'));
const wordCount = list.reduce((sum, t) => sum + t.words.length, 0);
---

<Base
  title="Codename Generator - project codenames from curated themes"
  description={`Generate project codenames from ${list.length} curated themes and ${wordCount} words, in English or German, with optional phonetic mutation.`}
>
  <header class="mb-8 border-b border-rule pb-6">
    <h1 class="text-2xl tracking-[0.3em] text-phosphor glow sm:text-3xl">
      CODENAME<span class="text-amber">·</span>GENERATOR<span class="cursor"></span>
    </h1>
    <p class="mt-3 max-w-2xl text-sm text-phosphor/70">
      {list.length} curated themes, {wordCount} words, English and German. Pick a theme, get a
      batch of names, copy what fits. Everything runs in your browser - nothing is sent anywhere.
    </p>
  </header>

  <Generator client:only="react" />

  <section class="mt-12 grid gap-6 border-t border-rule pt-6 text-sm text-phosphor/70 sm:grid-cols-2">
    <div>
      <h2 class="mb-2 text-xs uppercase tracking-[0.2em] text-phosphorDim">How it works</h2>
      <p>
        A name is a theme word plus a modifier: <b class="text-phosphor">Silent Falcon</b>,
        <b class="text-phosphor">Petra Sorter</b>, <b class="text-phosphor">Stiller Falke</b>.
        German inflects the modifier after the noun's gender, so the result reads like German
        rather than like a translation. Themes of proper names - gods, racehorses, Swatch models -
        work in both languages. A <span class="text-amber">*</span> marks a phonetic mutation,
        which nudges a word off the dictionary: Pegasus becomes Pegasos.
      </p>
    </div>
    <div>
      <h2 class="mb-2 text-xs uppercase tracking-[0.2em] text-phosphorDim">Terminal version</h2>
      <p>
        This site is the web face of a TUI written in Python. Same word lists, same rules:
        <a
          class="text-phosphor underline decoration-phosphorDim underline-offset-4 hover:text-amber"
          href="https://github.com/michaelblaess/codename-generator">github.com/michaelblaess/codename-generator</a
        >.
      </p>
      <p class="mt-3 text-xs text-phosphorDim">
        No warranty. Names are generated from word lists and may coincide with existing product,
        project or company names - check before you use one publicly.
      </p>
    </div>
  </section>

  <footer class="mt-10 border-t border-rule pt-4 text-xs text-phosphorDim">
    <a class="hover:text-phosphor" href="https://michaelblaess.de">Michael Blaess</a>
    <span class="mx-2">·</span>
    <a class="hover:text-phosphor" href="https://github.com/michaelblaess/codename-generator.de"
      >Source</a
    >
    <span class="mx-2">·</span>Apache-2.0
  </footer>
</Base>
