---
import Base from '../layouts/Base.astro';
import Generator from '../components/Generator.tsx';
import { themes } from '../lib/generator';

const list = themes().filter((t) => !t.slug.startsWith('random'));
const wordCount = list.reduce((sum, t) => sum + t.words.length, 0);

// Der Scroller traegt, was sonst als Fliesstext Platz kosten wuerde. Echte
// Umlaute - die Pixelschrift bringt sie mit (latin-Subset, U+0000-00FF).
const scroller = [
  'CODENAME GENERATOR',
  `${list.length} THEMEN`,
  `${wordCount} WÖRTER`,
  'ENGLISCH UND DEUTSCH',
  'IM DEUTSCHEN WIRD DER ZUSATZ GEBEUGT: STILLER FALKE - STILLE EULE - STILLES WIESEL',
  'ALLES LÄUFT IM BROWSER, NICHTS WIRD GESENDET',
  'DIESELBEN WORTLISTEN TREIBEN DIE TERMINALFASSUNG AN: GITHUB.COM/MICHAELBLAESS/CODENAME-GENERATOR',
  'NAMEN KÖNNEN MIT BESTEHENDEN PRODUKTNAMEN ZUSAMMENFALLEN - VOR VERWENDUNG PRÜFEN',
  'MICHAEL BLAESS 2026 - APACHE 2.0 - SCHRIFT PRESS START 2P (OFL)',
].join('   ***   ');
---

<Base
  title="Codename Generator - project codenames from curated themes"
  description={`Generate project codenames from ${list.length} curated themes and ${wordCount} words, in English or German, with optional phonetic mutation.`}
>
  <div class="bildschirm">
    <!-- Copper-Balken: der Vorspann faengt oben an. -->
    <div class="copper"></div>

    <!--
      Kopf im Ton einer Systemmeldung: Titel in Sternen, darunter der Bestand.
      Das Vorbild ist der Startbildschirm, der die freien Bytes meldete - hier
      sind es Themen und Woerter.
    -->
    <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 pt-3">
      <h1 class="pixel gold text-[0.8rem] sm:text-[1.05rem]">
        **** CODENAME GENERATOR ****
      </h1>
      <p class="pixel flex items-baseline gap-2 text-[0.5rem] text-magenta">
        <span>{list.length} THEMEN, {wordCount} WÖRTER FREI</span>
        <span aria-hidden="true" class="text-goldTief">·</span>
        <!--
          Die Statuszeile gehoert dem Generator, steht aber hier oben. React
          haengt sich per Portal in dieses Feld - bis dahin traegt es READY.
          als Platzhalter, damit die Kopfzeile nie leer springt.
        -->
        <span id="statuszeile" class="text-gruen" aria-live="polite">READY.</span>
      </p>
    </header>

    <Generator client:only="react" />

    <!-- Scroller: die Laufschrift gehoert zu einem Titelbildschirm dazu. -->
    <div class="scroller pixel text-[0.5rem]">
      <span>{scroller}</span>
    </div>
  </div>
</Base>
