---
import Base from '../layouts/Base.astro';
import Generator from '../components/Generator.tsx';
import { themes } from '../lib/generator';

const list = themes().filter((t) => !t.slug.startsWith('random'));
const wordCount = list.reduce((sum, t) => sum + t.words.length, 0);

// Der Scroller-Text laeuft unten durch - Platz fuer alles, was sonst als
// Fliesstext den Bildschirm zustellen wuerde.
const scroller = [
  'CODENAME GENERATOR',
  `${list.length} THEMEN`,
  `${wordCount} WOERTER`,
  'ENGLISCH UND DEUTSCH',
  'IM DEUTSCHEN WIRD DER ZUSATZ GEBEUGT: STILLER FALKE - STILLE EULE - STILLES WIESEL',
  'ALLES LAEUFT IM BROWSER, NICHTS WIRD GESENDET',
  'DIESELBEN WORTLISTEN TREIBEN DIE TERMINALFASSUNG AN',
  'NAMEN KOENNEN MIT BESTEHENDEN PRODUKTNAMEN ZUSAMMENFALLEN - VOR VERWENDUNG PRUEFEN',
  'F1 NEUE RUNDE   F3 SPRACHE   F5 WOERTER   F7 MITNEHMEN   PFEILTASTEN BLAETTERN',
].join('   ***   ');
---

<Base
  title="Codename Generator - project codenames from curated themes"
  description={`Generate project codenames from ${list.length} curated themes and ${wordCount} words, in English or German, with optional phonetic mutation.`}
>
  <div class="mx-auto max-w-5xl px-3 py-6 sm:px-6 sm:py-10">
    <div class="bildschirm">
      <!-- Copper-Balken: der Vorspann faengt oben an. -->
      <div class="copper"></div>

      <header class="border-b-4 border-schwarz bg-schirm px-4 py-5 text-center sm:px-8">
        <h1 class="pixel text-[1.35rem] leading-tight sm:text-[2.4rem]">
          <span class="chrom block">CODENAME</span>
          <span class="chrom mt-1 block">GENERATOR</span>
        </h1>
        <p class="pixel mt-4 text-[0.56rem] text-gelb">
          MICHAEL BLAESS 2026<span class="blinker"></span>
        </p>
        <p class="mx-auto mt-4 max-w-xl text-[0.84rem] leading-relaxed text-cyan">
          Namen für Projekte, die noch keinen haben. Thema wählen, Namen ziehen, mitnehmen.
        </p>
      </header>

      <Generator client:only="react" />

      <!-- Scroller: die Laufschrift gehoert zu einem Titelbildschirm dazu. -->
      <div class="scroller pixel text-[0.56rem]">
        <span>{scroller}</span>
      </div>
    </div>

    <footer class="pixel mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-center text-[0.5rem] text-schwarz">
      <a class="hover:text-white" href="https://michaelblaess.de">MICHAELBLAESS.DE</a>
      <a class="hover:text-white" href="https://github.com/michaelblaess/codename-generator">
        TERMINALFASSUNG
      </a>
      <span>APACHE 2.0</span>
      <span>SCHRIFT: PRESS START 2P (OFL)</span>
    </footer>
  </div>
</Base>
