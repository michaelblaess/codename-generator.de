---
/*
 * Traeger fuer Impressum und Datenschutz. Gleiche Optik wie der
 * Titelbildschirm, aber der Text darf rollen - Rechtstexte in einen
 * Bildschirm zu zwaengen waere albern.
 */
import Base from '../layouts/Base.astro';
import Fusszeile from '../components/Fusszeile.astro';
import { UI, pfad, type UiSprache } from '../i18n/ui';
import type { Rechtstext } from '../i18n/recht';

interface Props {
  sprache: UiSprache;
  seite: 'impressum' | 'datenschutz';
  text: Rechtstext;
}

const { sprache, seite, text } = Astro.props;
const t = UI[sprache];

// Adressen im Text anklickbar machen, ohne HTML in die Textdatei zu lassen.
function teile(zeile: string): Array<{ art: 'text' | 'link' | 'mail'; wert: string }> {
  const muster = /(https?:\/\/[^\s]+|[\w.+-]+@[\w.-]+\.\w+)/g;
  return zeile.split(muster).filter(Boolean).map((stueck) => {
    if (/^https?:\/\//.test(stueck)) return { art: 'link' as const, wert: stueck };
    if (/^[\w.+-]+@[\w.-]+\.\w+$/.test(stueck)) return { art: 'mail' as const, wert: stueck };
    return { art: 'text' as const, wert: stueck };
  });
}
---

<Base title={`${text.titel} - Codename Generator`} description={text.beschreibung} lang={sprache} seite={seite}>
  <div class="bildschirm">
    <div class="copper"></div>

    <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 pt-3">
      <h1 class="pixel gold text-[0.7rem] sm:text-[0.95rem]">
        **** {text.titel.toUpperCase()} ****
      </h1>
      <a href={pfad('start', sprache)} class="pixel fussweg text-[0.5rem]">{t.zurueck}</a>
    </header>

    <div class="kanal waechst overflow-y-auto px-4 py-3">
      <div class="panel mx-auto max-w-3xl px-5 py-4 text-[0.86rem] leading-relaxed">
        {
          text.absaetze.map((absatz) => (
            <section class="mb-5 last:mb-0">
              <h2 class="pixel mb-2 text-[0.5rem] text-gold">{absatz.titel.toUpperCase()}</h2>
              {absatz.zeilen.map((zeile) => (
                <p class="mb-1 text-creme last:mb-0">
                  {teile(zeile).map((stueck) =>
                    stueck.art === 'link' ? (
                      <a href={stueck.wert} class="fussweg break-all" rel="noopener noreferrer" target="_blank">
                        {stueck.wert}
                      </a>
                    ) : stueck.art === 'mail' ? (
                      <a href={`mailto:${stueck.wert}`} class="fussweg">
                        {stueck.wert}
                      </a>
                    ) : (
                      <span>{stueck.wert}</span>
                    ),
                  )}
                </p>
              ))}
            </section>
          ))
        }
        <p class="pixel mt-4 text-[0.44rem] text-dunst">{text.stand}</p>
      </div>
    </div>

    <Fusszeile sprache={sprache} seite={seite} />
  </div>
</Base>
