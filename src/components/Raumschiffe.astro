---
/*
 * Kleine Schiffe in den freien Raendern links und rechts.
 *
 * Sie steigen von unten auf, drehen sich oben um die Querachse und sinken
 * wieder ab - der Wendeeffekt aus Uridium, bei dem das Schiff zu einem Strich
 * zusammenlaeuft und andersherum wieder herauskommt. Waehrend des Flugs rollt
 * es zweimal um die Laengsachse.
 *
 * Drei Bedingungen, sonst passiert gar nichts:
 *   - genug Rand: erst ab 1400px ist links und rechts Platz neben dem
 *     78rem breiten Bildschirmkasten. Auf dem Telefon fliegt nichts.
 *   - prefers-reduced-motion aus.
 *   - der Tab ist sichtbar.
 *
 * Sie laufen NICHT dauernd: nach einem Flug vergeht eine zufaellige Pause.
 * position: fixed und pointer-events: none - der Seitenfluss bleibt
 * unberuehrt, sonst waere die Ein-Bildschirm-Regel hin.
 */
---

<div class="flugfeld" aria-hidden="true"></div>

<!--
  is:global ist hier Pflicht, keine Bequemlichkeit: Astro kapselt Styles ueber
  ein Attribut, das nur Elemente aus dem Template bekommen. Die Schiffe
  entstehen zur Laufzeit in JS - mit gekapseltem Style griffe keine einzige
  Regel, gemessen als transform: none, Groesse 0 und leere getAnimations().
-->
<style is:global>
  .flugfeld {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  /* Unter 1400px ist der Rand zu schmal - dann bleibt das Feld leer. */
  @media (max-width: 1399px) {
    .flugfeld {
      display: none;
    }
  }

  .schiff {
    position: absolute;
    bottom: -5rem;
    width: 2.6rem;
    height: 4rem;
    animation: flug var(--dauer, 15s) linear forwards;
  }

  /* Der Rollflug liegt auf einer eigenen Ebene, damit er den Wendeeffekt
     der aeusseren Ebene nicht ueberschreibt. */
  .schiff > svg {
    display: block;
    width: 100%;
    height: 100%;
    animation: rolle 2.8s ease-in-out var(--rollpause, 3s) 2;
  }

  @keyframes flug {
    0% {
      transform: translateY(0) scaleY(1);
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    44% {
      transform: translateY(calc(-1 * var(--strecke))) scaleY(1);
    }
    /* Die Wende: zu einem Strich zusammen und andersherum wieder auf. */
    47% {
      transform: translateY(calc(-1 * var(--strecke))) scaleY(0.05);
    }
    50% {
      transform: translateY(calc(-1 * var(--strecke))) scaleY(-1);
    }
    94% {
      transform: translateY(0) scaleY(-1);
      opacity: 1;
    }
    100% {
      transform: translateY(0) scaleY(-1);
      opacity: 0;
    }
  }

  @keyframes rolle {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flugfeld {
      display: none;
    }
  }
</style>

<script>
  // Der Rumpf in Gold, die Triebwerke in Magenta - dieselben vier Farben wie
  // der Rest der Seite, damit es nicht wie ein fremdes Bildchen wirkt.
  const RUMPF = `<svg viewBox="0 0 21 32" xmlns="http://www.w3.org/2000/svg">
  <path d="M10.5 0 L14 9 L14 20 L18 24 L18 28 L13 26 L13 30 L8 30 L8 26 L3 28 L3 24 L7 20 L7 9 Z"
        fill="#e0a82e" stroke="#8a5f14" stroke-width="0.8" stroke-linejoin="round"/>
  <path d="M10.5 4 L12 10 L9 10 Z" fill="#ffe9a8"/>
  <rect x="8" y="29" width="2" height="3" fill="#c13bb0"/>
  <rect x="11" y="29" width="2" height="3" fill="#c13bb0"/>
</svg>`;

  const feld = document.querySelector('.flugfeld');
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');
  const breit = window.matchMedia('(min-width: 1400px)');

  function zufall(von, bis) {
    return von + Math.random() * (bis - von);
  }

  function starten() {
    if (!feld || ruhig.matches || !breit.matches || document.hidden) return;

    const schiff = document.createElement('div');
    schiff.className = 'schiff';
    schiff.innerHTML = RUMPF;

    // Der freie Rand neben dem 78rem breiten Kasten. Die eigene Breite muss
    // abgezogen werden, sonst ragt das Schiff bei knapp 1400px in den Kasten:
    // Rand 76px, Spur bis 53px, Breite 42px - das waere ueber der Themenliste.
    const BREITE = 42;
    const rand = (window.innerWidth - 78 * 16) / 2;
    const spur = zufall(0.1, 0.9) * Math.max(0, rand - BREITE);
    if (Math.random() < 0.5) {
      schiff.style.left = `${spur}px`;
    } else {
      schiff.style.right = `${spur}px`;
    }

    const dauer = zufall(13, 19);
    schiff.style.setProperty('--dauer', `${dauer}s`);
    // Die Strecke ist so bemessen, dass die Wende SICHTBAR am oberen Rand
    // stattfindet. Mit innerHeight + 100 lag sie bei y = -48, also knapp
    // ausserhalb des Bildes - der schoenste Teil war nie zu sehen.
    schiff.style.setProperty('--strecke', `${window.innerHeight - 10}px`);
    schiff.style.setProperty('--rollpause', `${zufall(1.5, 4)}s`);
    // Nur auf den Flug hoeren. animationend blubbert auch vom Rollflug des
    // SVG herauf, und ohne diese Pruefung verschwindet das Schiff schon nach
    // der ersten Rolle - gemessen, bevor es je die Wende erreicht hat.
    schiff.addEventListener('animationend', (e) => {
      if (e.animationName === 'flug') schiff.remove();
    });
    feld.appendChild(schiff);
  }

  function planen() {
    // Erst eine lange Pause, dann ab und zu eins. Dauerbetrieb waere Kirmes.
    window.setTimeout(
      () => {
        starten();
        planen();
      },
      zufall(18000, 55000),
    );
  }

  if (feld && !ruhig.matches && breit.matches) {
    window.setTimeout(starten, 6000);
    planen();
  }
</script>
