---
/*
 * Kleine Schiffe in den freien Raendern links und rechts.
 *
 * Optik: Drahtgitter im Stil des C64-Elite - helle Linien, keine Fuellung.
 * Die erste Fassung war ein ausgefuelltes Dreieck und sah nach Rakete aus.
 *
 * Bewegung, drei Ebenen uebereinander:
 *   .schiffbahn  seitliches Treiben, damit die Bahn nicht schnurgerade ist
 *   .schiff      Steigflug mit wechselndem Schub, oben die Wende
 *   svg          Rollflug um die Laengsachse
 *
 * Die Wende ist der Uridium-Effekt: das Schiff laeuft zu einem Strich
 * zusammen und kommt kopfueber wieder heraus.
 *
 * Gelegentlich statt eines Flugs ein Gefecht wie bei Space Invaders: oben
 * kommt ein Schiff mit der Nase nach unten herein, unten eines mit der Nase
 * nach oben. Sie fliegen aufeinander zu und schiessen dabei, je naeher, desto
 * sicherer der Treffer - der zerlegt das Schiff in Pixelsplitter. Ueberleben
 * beide, weichen sie kurz vor der Begegnung seitlich aus und fliegen
 * aneinander vorbei aus dem Bild. Das Ereignis
 * `raumschiffe:gefecht` auf document startet eines sofort (Smoketest).
 *
 * Drei Bedingungen, sonst passiert gar nichts:
 *   - genug Rand: erst ab 1400px ist links und rechts Platz neben dem
 *     78rem breiten Bildschirmkasten. Auf dem Telefon fliegt nichts.
 *   - prefers-reduced-motion aus.
 *   - der Tab ist sichtbar.
 *
 * position: fixed und pointer-events: none - der Seitenfluss bleibt
 * unberuehrt, sonst waere die Ein-Bildschirm-Regel hin.
 */
---

<div class="flugfeld" aria-hidden="true"></div>

<!--
  is:global ist hier Pflicht, keine Bequemlichkeit: Astro kapselt Styles ueber
  ein Attribut, das nur Elemente aus dem Template bekommen. Die Schiffe
  entstehen zur Laufzeit in JS - mit gekapseltem Style griffe keine einzige
  Regel, gemessen als transform: none, Groesse 0 und leere getAnimations().
-->
<style is:global>
  .flugfeld {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  /* Unter 1400px ist der Rand zu schmal - dann bleibt das Feld leer. */
  @media (max-width: 1399px) {
    .flugfeld {
      display: none;
    }
  }

  .schiffbahn {
    position: absolute;
    bottom: -5rem;
    animation: pendeln var(--dauer, 15s) ease-in-out forwards;
  }

  .schiff {
    /* --tiefe staffelt die Groesse: ein kleines Schiff liest sich als
       weiter weg. Die Perspektive gilt fuer die Ebene darunter. */
    width: calc(3.6rem * var(--tiefe, 1));
    /* 3,45rem statt 2,85rem: die Kippung staucht die Hoehe um cos(34 Grad).
       Der Kasten wird entsprechend hoeher angelegt, damit das Schiff nach
       der Kippung wieder 48 zu 38 steht und nicht gedrungen wirkt. */
    height: calc(3.45rem * var(--tiefe, 1));
    perspective: 22rem;
    animation: flug var(--dauer, 15s) linear forwards;
  }

  /* Der Koerper steht nicht flach auf dem Schirm, sondern kippt von der
     Kamera weg - erst das gibt dem Rumpf Tiefe. */
  .schiffkoerper {
    width: 100%;
    height: 100%;
    transform: rotateX(34deg);
    transform-style: preserve-3d;
    filter: drop-shadow(0 3px 4px rgb(0 0 0 / 85%));
  }

  .schiffkoerper > svg {
    display: block;
    width: 100%;
    height: 100%;
    animation: rolle 2.8s ease-in-out var(--rollpause, 3s) 2;
  }

  /*
   * Der Steigflug haelt keine feste Geschwindigkeit: kurze Schuebe, dann
   * ausrollen. Zeitanteile und Streckenanteile laufen bewusst auseinander,
   * daher der Wechsel aus Beschleunigen und Treiben.
   */
  @keyframes flug {
    0% {
      transform: translateY(0) scaleY(1);
      opacity: 0;
    }
    5% {
      transform: translateY(calc(var(--strecke) * -0.03)) scaleY(1);
      opacity: 1;
    }
    14% {
      transform: translateY(calc(var(--strecke) * -0.1)) scaleY(1);
      animation-timing-function: ease-out;
    }
    22% {
      transform: translateY(calc(var(--strecke) * -0.16)) scaleY(1);
      animation-timing-function: ease-in;
    }
    30% {
      transform: translateY(calc(var(--strecke) * -0.42)) scaleY(1);
      animation-timing-function: ease-out;
    }
    38% {
      transform: translateY(calc(var(--strecke) * -0.62)) scaleY(1);
      animation-timing-function: ease-in;
    }
    44% {
      transform: translateY(calc(var(--strecke) * -1)) scaleY(1);
    }
    /* Die Wende: zu einem Strich zusammen und andersherum wieder auf. */
    47% {
      transform: translateY(calc(var(--strecke) * -1)) scaleY(0.05);
    }
    50% {
      transform: translateY(calc(var(--strecke) * -1)) scaleY(-1);
      animation-timing-function: ease-in;
    }
    58% {
      transform: translateY(calc(var(--strecke) * -0.7)) scaleY(-1);
      animation-timing-function: ease-out;
    }
    66% {
      transform: translateY(calc(var(--strecke) * -0.54)) scaleY(-1);
      animation-timing-function: ease-in;
    }
    76% {
      transform: translateY(calc(var(--strecke) * -0.26)) scaleY(-1);
      animation-timing-function: ease-out;
    }
    86% {
      transform: translateY(calc(var(--strecke) * -0.14)) scaleY(-1);
    }
    94% {
      transform: translateY(0) scaleY(-1);
      opacity: 1;
    }
    100% {
      transform: translateY(0) scaleY(-1);
      opacity: 0;
    }
  }

  /* Seitliches Treiben. Der Ausschlag steckt in --seit und ist so bemessen,
     dass das Schiff im freien Rand bleibt. */
  @keyframes pendeln {
    0% {
      transform: translateX(0);
    }
    23% {
      transform: translateX(var(--seit));
    }
    52% {
      transform: translateX(calc(var(--seit) * -1));
    }
    78% {
      transform: translateX(calc(var(--seit) * 0.6));
    }
    100% {
      transform: translateX(0);
    }
  }

  /* --- Gefecht ----------------------------------------------------------- */
  .duell-schiff {
    position: absolute;
    width: calc(3.6rem * 0.8);
    height: calc(3.45rem * 0.8);
    perspective: 22rem;
  }

  /* Das obere Schiff fliegt mit der Nase nach unten. */
  .duell-schiff[data-rolle='oben'] {
    transform: rotate(180deg);
  }

  .duell-schiff.getroffen {
    animation: getroffen 0.35s ease-in forwards;
  }

  .schuss {
    position: absolute;
    width: 3px;
    height: 12px;
    border-radius: 1px;
  }

  .schuss[data-von='oben'] {
    background: #ff5fe8;
    box-shadow: 0 0 6px #ff5fe8;
  }

  .schuss[data-von='unten'] {
    background: #7dff9b;
    box-shadow: 0 0 6px #7dff9b;
  }

  /* Pixelsplitter - bei 4px waren sie auf dem Schirm kaum zu sehen. */
  .splitter {
    position: absolute;
    width: 6px;
    height: 6px;
    animation: splitter 1.1s ease-out forwards;
  }

  /* Kurzer Lichtblitz am Einschlag, dann fliegen die Splitter. */
  .blitz {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff6dd 0%, #ff5fe8 45%, transparent 70%);
    animation: blitz 0.45s ease-out forwards;
  }

  @keyframes blitz {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(9);
      opacity: 0;
    }
  }

  @keyframes getroffen {
    0% {
      filter: brightness(3);
      opacity: 1;
    }
    100% {
      filter: brightness(3);
      opacity: 0;
      scale: 0.2;
    }
  }

  @keyframes splitter {
    0% {
      transform: translate(0, 0);
      opacity: 1;
    }
    100% {
      transform: translate(var(--dx), var(--dy));
      opacity: 0;
    }
  }

  @keyframes rolle {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flugfeld {
      display: none;
    }
  }
</style>

<script>
  /*
   * Form nach dem Vorbild der Elite-Schiffe (Cobra, Blick von oben, weil das
   * Schiff senkrecht fliegt): breiter Keil mit zwei Fluegeln und flachem
   * Heck. Gefuellt in Gold, nicht als Drahtgitter.
   *
   * Die Textur macht zweierlei: die Flaechen sind in Facetten verschiedener
   * Goldtoene aufgeteilt, das liest sich als Schattierung eines Koerpers,
   * und darueber liegt ein feines Linienraster. Die Kanten tragen einen
   * dunklen Rand, sonst verschwimmt das Schiff auf dem schwarzen Grund.
   */
  const RUMPF = `<svg viewBox="0 0 48 38" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="schiffRumpf" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff6dd"/>
      <stop offset="0.45" stop-color="#e8b93f"/>
      <stop offset="1" stop-color="#b8842a"/>
    </linearGradient>
    <pattern id="schiffRaster" width="3" height="3" patternUnits="userSpaceOnUse">
      <path d="M0 0 L3 3" stroke="#07070c" stroke-width="0.5" opacity="0.35"/>
    </pattern>
  </defs>
  <g stroke="#5c3d0c" stroke-width="0.9" stroke-linejoin="round">
    <!-- Fluegel: scharf ausgestellt, mit abgeschraegten Spitzen. Der Rumpf
         muss deutlich schmaler bleiben als die Spannweite, sonst verschmilzt
         beides zu einem Dreieck - genau daran ist der erste Entwurf
         gescheitert. -->
    <path d="M20 14 L1 32 L4 36 L20 36 Z" fill="#7a5615"/>
    <path d="M28 14 L47 32 L44 36 L28 36 Z" fill="#f0c552"/>
    <path d="M20 14 L1 32 L4 36 L20 36 Z" fill="url(#schiffRaster)" stroke="none"/>
    <path d="M28 14 L47 32 L44 36 L28 36 Z" fill="url(#schiffRaster)" stroke="none"/>
    <!-- Schlanker Rumpf mit der Kerbe zwischen den Triebwerken -->
    <path d="M24 2 L28 14 L28 36 L26 31 L22 31 L20 36 L20 14 Z" fill="url(#schiffRumpf)"/>
    <path d="M24 2 L28 14 L28 36 L26 31 L22 31 L20 36 L20 14 Z"
          fill="url(#schiffRaster)" stroke="none" opacity="0.45"/>
    <!-- Glanzkante auf der Lichtseite, dunkle Kante im Schatten: erst der
         Unterschied laesst den Rumpf als Koerper erscheinen. -->
    <path d="M24 2 L28 14 L28 36" stroke="#fff6dd" stroke-width="1" fill="none"/>
    <path d="M24 2 L20 14 L20 36" stroke="#4a2f08" stroke-width="1" fill="none"/>
    <path d="M28 14 L47 32" stroke="#fff6dd" stroke-width="0.8" fill="none" opacity="0.8"/>
    <!-- Kanzel -->
    <path d="M21.5 9 L26.5 9 L27 15 L21 15 Z" fill="#2a0c30" stroke="#8a5f14" stroke-width="0.6"/>
    <path d="M22 9.6 L25 9.6 L23.2 14.4 L21.6 14.4 Z" fill="#a08fb0" opacity="0.55" stroke="none"/>
    <!-- Triebwerke links und rechts der Kerbe -->
    <rect x="20.5" y="31" width="3" height="5" fill="#c13bb0" stroke="#6a1d6e" stroke-width="0.6"/>
    <rect x="24.5" y="31" width="3" height="5" fill="#c13bb0" stroke="#6a1d6e" stroke-width="0.6"/>
  </g>
</svg>`;

  const feld = document.querySelector('.flugfeld');
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');
  const breit = window.matchMedia('(min-width: 1400px)');
  const BREITE = 58;
  // Welche Seiten gerade befahren sind - siehe Kollisionssperre unten.
  const belegt = new Set();

  function zufall(von, bis) {
    return von + Math.random() * (bis - von);
  }

  function starten() {
    if (!feld || ruhig.matches || !breit.matches || document.hidden) return;

    // Pro Seite darf immer nur EIN Schiff unterwegs sein. Im freien Rand ist
    // neben Rumpfbreite und seitlichem Ausschlag kein Platz fuer ein
    // zweites, die beiden wuerden sich sonst durchdringen.
    const frei_seiten = ['links', 'rechts'].filter((s) => !belegt.has(s));
    if (frei_seiten.length === 0) return;
    const seite = frei_seiten[Math.floor(Math.random() * frei_seiten.length)];
    belegt.add(seite);

    const bahn = document.createElement('div');
    bahn.className = 'schiffbahn';
    bahn.dataset.seite = seite;
    const schiff = document.createElement('div');
    schiff.className = 'schiff';
    const koerper = document.createElement('div');
    koerper.className = 'schiffkoerper';
    koerper.innerHTML = RUMPF;
    schiff.appendChild(koerper);
    bahn.appendChild(schiff);

    // Der freie Rand neben dem 78rem breiten Kasten. Eigene Breite UND
    // seitlicher Ausschlag muessen hineinpassen, sonst haengt das Schiff
    // ueber der Themenliste.
    const rand = (window.innerWidth - 78 * 16) / 2;
    const frei = Math.max(0, rand - BREITE);
    const seit = Math.min(26, frei / 2);
    const grund = seit + zufall(0, Math.max(0, frei - seit * 2));
    if (seite === 'links') {
      bahn.style.left = `${grund}px`;
    } else {
      bahn.style.right = `${grund}px`;
    }

    const dauer = zufall(13, 19);
    for (const el of [bahn, schiff]) {
      el.style.setProperty('--dauer', `${dauer}s`);
    }
    bahn.style.setProperty('--seit', `${seit}px`);
    // Die Strecke ist so bemessen, dass die Wende SICHTBAR am oberen Rand
    // stattfindet. Mit innerHeight + 100 lag sie bei y = -48, also knapp
    // ausserhalb des Bildes - der schoenste Teil war nie zu sehen.
    schiff.style.setProperty('--strecke', `${window.innerHeight - 10}px`);
    schiff.style.setProperty('--rollpause', `${zufall(1.5, 4)}s`);
    // Nur auf den Flug hoeren. animationend blubbert auch vom Rollflug des
    // SVG herauf, und ohne diese Pruefung verschwindet das Schiff schon nach
    // der ersten Rolle - gemessen, bevor es je die Wende erreicht hat.
    // Ein weiter entferntes Schiff ist kleiner und langsamer unterwegs.
    const tiefe = zufall(0.62, 1);
    schiff.style.setProperty('--tiefe', `${tiefe.toFixed(2)}`);
    schiff.addEventListener('animationend', (e) => {
      if (e.animationName !== 'flug') return;
      bahn.remove();
      belegt.delete(seite);
    });
    feld.appendChild(bahn);
  }

  // --- Gefecht ---------------------------------------------------------------
  // Erst ab so viel Rand: darunter bleibt fuer das Pendeln kaum Weg, und die
  // Schiffe stuenden nur uebereinander.
  const GEFECHT_MIN_RAND = 120;
  // Sicherheitsnetz, falls ein Schiff aus irgendeinem Grund nie hinausfliegt.
  const GEFECHT_HOECHSTENS = 25;
  // So lange braucht ein Schiff von Rand zu Rand, die Begegnung liegt in der Mitte.
  const GEFECHT_FLUGZEIT = 9;
  const SCHUSS_TEMPO = 560;
  const SPLITTER_FARBEN = ['#fff6dd', '#e8b93f', '#c13bb0', '#ff5fe8'];

  function schiffBauen(rolle) {
    const el = document.createElement('div');
    el.className = 'duell-schiff';
    el.dataset.rolle = rolle;
    const koerper = document.createElement('div');
    koerper.className = 'schiffkoerper';
    koerper.innerHTML = RUMPF;
    el.appendChild(koerper);
    feld.appendChild(el);
    return el;
  }

  function zerplatzen(x, y) {
    const blitz = document.createElement('div');
    blitz.className = 'blitz';
    blitz.style.left = `${x}px`;
    blitz.style.top = `${y}px`;
    blitz.addEventListener('animationend', () => blitz.remove());
    feld.appendChild(blitz);
    for (let i = 0; i < 24; i += 1) {
      const teil = document.createElement('div');
      teil.className = 'splitter';
      const winkel = zufall(0, Math.PI * 2);
      const weite = zufall(30, 110);
      teil.style.left = `${x}px`;
      teil.style.top = `${y}px`;
      teil.style.background = SPLITTER_FARBEN[i % SPLITTER_FARBEN.length];
      teil.style.setProperty('--dx', `${Math.cos(winkel) * weite}px`);
      teil.style.setProperty('--dy', `${Math.sin(winkel) * weite}px`);
      teil.addEventListener('animationend', () => teil.remove());
      feld.appendChild(teil);
    }
  }

  function gefechtStarten() {
    if (!feld || ruhig.matches || !breit.matches || document.hidden) return false;
    const rand = (window.innerWidth - 78 * 16) / 2;
    if (rand < GEFECHT_MIN_RAND) return false;
    const frei_seiten = ['links', 'rechts'].filter((s) => !belegt.has(s));
    if (frei_seiten.length === 0) return false;
    const seite = frei_seiten[Math.floor(Math.random() * frei_seiten.length)];
    belegt.add(seite);

    const hoehe = window.innerHeight;
    const probe = schiffBauen('unten');
    const breite = probe.offsetWidth;
    const hoch = probe.offsetHeight;
    probe.remove();
    // Pendelbereich im Rand, mit etwas Abstand zu Fensterkante und Kasten.
    const anfang = (seite === 'links' ? 0 : window.innerWidth - rand) + 8;
    const spiel = Math.max(0, rand - breite - 16);
    const mitte = anfang + spiel / 2;

    const tempo = (hoehe + 2 * hoch + 20) / GEFECHT_FLUGZEIT;
    const schiffe = ['oben', 'unten'].map((rolle) => ({
      rolle,
      el: schiffBauen(rolle),
      x: mitte,
      y: rolle === 'oben' ? -hoch - 10 : hoehe + 10,
      vy: rolle === 'oben' ? tempo : -tempo,
      // Ausweichbahn fuer die Begegnung: oben links, unten rechts im Rand.
      bahn: rolle === 'oben' ? anfang : anfang + spiel,
      takt: zufall(1.1, 1.9),
      phase: zufall(0, Math.PI * 2),
      laden: zufall(0.4, 0.9),
      lebt: true,
      // Steht das Schiff einmal auf seiner Ausweichbahn, bleibt es dort.
      gebunden: false,
    }));
    const [oben, unten] = schiffe;
    const schuesse = [];
    let zeit = 0;
    let ende = null;
    let vorher = performance.now();

    function zeichnen(s) {
      s.el.style.left = `${s.x}px`;
      s.el.style.top = `${s.y}px`;
    }

    function feuern(s) {
      const el = document.createElement('div');
      el.className = 'schuss';
      el.dataset.von = s.rolle;
      feld.appendChild(el);
      schuesse.push({
        el,
        von: s.rolle,
        x: s.x + breite / 2 - 1.5,
        y: s.rolle === 'oben' ? s.y + hoch : s.y - 12,
        vy: s.rolle === 'oben' ? SCHUSS_TEMPO : -SCHUSS_TEMPO,
      });
    }

    function schritt(jetzt) {
      // Nach einem verborgenen Tab kaeme sonst ein Riesenschritt auf einmal.
      const dt = Math.min(0.05, (jetzt - vorher) / 1000);
      vorher = jetzt;
      zeit += dt;

      // Abstand zwischen Nase und Nase. Wird er klein, weichen beide auf ihre
      // Bahn aus, sonst stiessen sie zusammen. Nach der Begegnung bleiben sie
      // dort und fliegen aneinander vorbei hinaus.
      const luecke = unten.y - (oben.y + hoch);
      const beide = oben.lebt && unten.lebt;
      const ausweichen = beide ? Math.min(1, Math.max(0, 1 - luecke / (3 * hoch))) : 0;
      for (const s of schiffe) {
        if (!s.lebt) continue;
        s.y += s.vy * dt;
        const pendel = mitte + (spiel / 2) * Math.sin(zeit * s.takt + s.phase);
        // Nach einem Abschuss behaelt der Sieger seine Bahn, er pendelt nicht zurueck.
        if (!s.gebunden) s.x = pendel + (s.bahn - pendel) * ausweichen;
        if (ausweichen >= 1) s.gebunden = true;
        const gegner = schiffe.find((g) => g !== s);
        // Geschossen wird nur im Anflug - nach der Begegnung zeigt die Nase weg.
        const im_anflug = gegner.lebt && luecke > hoch && ende === null;
        s.laden -= dt;
        const auf_linie = Math.abs(gegner.x - s.x) < breite * 0.6;
        if (im_anflug && s.laden <= 0 && (auf_linie || Math.random() < 0.25)) {
          feuern(s);
          s.laden = zufall(0.5, 1.0);
        }
        zeichnen(s);
      }

      for (const schuss of [...schuesse]) {
        schuss.y += schuss.vy * dt;
        schuss.el.style.left = `${schuss.x}px`;
        schuss.el.style.top = `${schuss.y}px`;
        const ziel = schiffe.find((s) => s.rolle !== schuss.von);
        const treffer =
          ende === null &&
          ziel.lebt &&
          schuss.x + 3 > ziel.x + 6 &&
          schuss.x < ziel.x + breite - 6 &&
          schuss.y + 12 > ziel.y + 6 &&
          schuss.y < ziel.y + hoch - 6;
        if (treffer) {
          ziel.lebt = false;
          ziel.el.classList.add('getroffen');
          zerplatzen(ziel.x + breite / 2, ziel.y + hoch / 2);
          ende = zeit;
        }
        if (treffer || schuss.y < -20 || schuss.y > hoehe + 20) {
          schuss.el.remove();
          schuesse.splice(schuesse.indexOf(schuss), 1);
        }
      }

      const draussen = schiffe.every(
        (s) => !s.lebt || (s.rolle === 'oben' ? s.y > hoehe + 20 : s.y < -hoch - 20),
      );
      if (schuesse.length === 0 && (draussen || zeit > GEFECHT_HOECHSTENS)) {
        for (const s of schiffe) s.el.remove();
        belegt.delete(seite);
        return;
      }
      window.requestAnimationFrame(schritt);
    }

    for (const s of schiffe) zeichnen(s);
    window.requestAnimationFrame(schritt);
    return true;
  }

  function planen() {
    // Dichter Verkehr: alle 3 bis 8 Sekunden ein Startversuch. Ein Flug
    // dauert 13 bis 19 Sekunden und belegt seine Seite, so ist fast immer ein
    // Schiff unterwegs (vorher lagen 9 bis 26 Sekunden zwischen den Starts,
    // und es gab Pausen von zehn Sekunden ohne jedes Schiff).
    // Etwa jeder dritte Auftritt ist ein Gefecht, sofern der Rand reicht.
    window.setTimeout(
      () => {
        if (!(Math.random() < 0.33 && gefechtStarten())) {
          starten();
          if (Math.random() < 0.35) window.setTimeout(starten, zufall(900, 2600));
        }
        planen();
      },
      zufall(3000, 8000),
    );
  }

  document.addEventListener('raumschiffe:gefecht', () => gefechtStarten());

  if (feld && !ruhig.matches && breit.matches) {
    window.setTimeout(starten, 1500);
    planen();
  }
</script>
