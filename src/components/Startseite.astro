---
/*
 * Der Titelbildschirm. Beide Sprachfassungen benutzen diese eine Datei, die
 * Seiten unter pages/ sind nur duenne Huellen - so kann keine Fassung
 * hinterherhinken.
 */
import Base from '../layouts/Base.astro';
import Generator from './Generator.tsx';
import Fusszeile from './Fusszeile.astro';
import { themes } from '../lib/generator';
import { UI, type UiSprache } from '../i18n/ui';

interface Props {
  sprache: UiSprache;
}

const { sprache } = Astro.props;
const t = UI[sprache];

const list = themes().filter((th) => !th.slug.startsWith('random'));
const wordCount = list.reduce((sum, th) => sum + th.words.length, 0);
const laufschrift = t.laufschrift.join('   ***   ');
---

<Base title={t.seitentitel} description={t.seitenbeschreibung} lang={sprache}>
  <div class="bildschirm bildschirm-start">
    <!-- Copper-Balken: der Vorspann faengt oben an. -->
    <div class="copper"></div>

    <!--
      Kopf im Ton einer Systemmeldung: Titel in Sternen, darunter der Bestand.
      Das Vorbild ist der Startbildschirm, der die freien Bytes meldete - hier
      sind es Themen und Woerter.
    -->
    <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 pt-3">
      <h1 class="pixel gold text-[0.8rem] sm:text-[1.05rem]">
        **** CODENAME GENERATOR ****
      </h1>
      <p class="pixel flex items-baseline gap-2 text-[0.5rem] text-magenta">
        <span>{t.bestand(list.length, wordCount)}</span>
        <span aria-hidden="true" class="text-goldTief">·</span>
        <!--
          Die Statuszeile gehoert dem Generator, steht aber hier oben. React
          haengt sich per Portal in dieses Feld - bis dahin traegt es READY.
          als Platzhalter, damit die Kopfzeile nie leer springt.
        -->
        <span id="statuszeile" class="text-gruen" aria-live="polite">{t.bereit}</span>
      </p>
    </header>

    <Generator client:only="react" sprache={sprache} />

    <Fusszeile sprache={sprache} seite="start" />

    <!-- Laufschrift: die gehoert zu einem Titelbildschirm dazu. -->
    <div class="scroller pixel text-[0.5rem]">
      <span>{laufschrift}</span>
    </div>
  </div>
</Base>
