---
import '../styles/global.css';
// Die Schrift laeuft ueber Vite, nicht ueber public/. Nur so traegt die URL den
// Basispfad - ein url(/fonts/...) in der CSS-Datei laeuft unter
// /codename-generator.de/ ins Leere und die Seite faellt still auf Consolas
// zurueck.
import plexMono from '../assets/fonts/plexmono.woff2';
import pressStart from '../assets/fonts/pressstart.woff2';
// Bungee traegt nur den grossen Namen - ein Schriftzug im Ton eines
// Spielhallen-Logos. Alles Lesbare bleibt in PlexMono.
import bungee from '../assets/fonts/bungee.woff2';
import { pfad } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  // Das Sprachattribut stand frueher fest auf "en", obwohl die Seite deutsch
  // ist - Vorleseprogramme haben den Text dann englisch ausgesprochen.
  lang?: 'de' | 'en';
  // Fuer die hreflang-Verweise auf dieselbe Seite in der anderen Sprache.
  // Ohne Angabe (404) gibt es keine Gegenstuecke.
  seite?: 'start' | 'impressum' | 'datenschutz';
}

const { title, description, lang = 'de', seite } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// BASE_URL uebernimmt die Schreibweise aus astro.config und kann mit oder ohne
// Schraegstrich enden - deshalb hier normalisieren, sonst entsteht
// "/codename-generator.defavicon.svg".
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
// Englisch ist die Vorgabe fuer alle anderen Sprachen, wie beim Generator.
const sprachen = seite
  ? [
      { hreflang: 'de', href: new URL(pfad(seite, 'de'), Astro.site) },
      { hreflang: 'en', href: new URL(pfad(seite, 'en'), Astro.site) },
      { hreflang: 'x-default', href: new URL(pfad(seite, 'en'), Astro.site) },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    {sprachen.map((s) => <link rel="alternate" hreflang={s.hreflang} href={s.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#352879" />
    <link rel="preload" href={plexMono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pressStart} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bungee} as="font" type="font/woff2" crossorigin />
    <style
      is:inline
      set:html={`@font-face{font-family:PlexMono;src:url("${plexMono}") format("woff2");font-weight:400 600;font-display:swap}@font-face{font-family:PressStart;src:url("${pressStart}") format("woff2");font-weight:400;font-display:swap}@font-face{font-family:Bungee;src:url("${bungee}") format("woff2");font-weight:400;font-display:swap}`}
    ></style>
  </head>
  <body class="font-mono">
    <slot />
  </body>
</html>
