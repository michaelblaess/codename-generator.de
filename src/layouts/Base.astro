---
import '../styles/global.css';
// Die Schrift laeuft ueber Vite, nicht ueber public/. Nur so traegt die URL den
// Basispfad - ein url(/fonts/...) in der CSS-Datei laeuft unter
// /codename-generator.de/ ins Leere und die Seite faellt still auf Consolas
// zurueck.
import plexMono from '../assets/fonts/plexmono.woff2';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// BASE_URL uebernimmt die Schreibweise aus astro.config und kann mit oder ohne
// Schraegstrich enden - deshalb hier normalisieren, sonst entsteht
// "/codename-generator.defavicon.svg".
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#23201c" />
    <link rel="preload" href={plexMono} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:PlexMono;src:url("${plexMono}") format("woff2");font-weight:400 600;font-display:swap}`}></style>
  </head>
  <body class="font-mono">
    <slot />
  </body>
</html>
